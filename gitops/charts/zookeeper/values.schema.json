{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "replicaCount",
    "image",
    "nameOverride",
    "fullnameOverride",
    "commonLabels",
    "serviceAccount",
    "podAnnotations",
    "podLabels",
    "service",
    "configuration",
    "jvm",
    "persistence",
    "resources",
    "probes",
    "terminationGracePeriodSeconds",
    "securityContext",
    "topology",
    "podDisruptionBudget",
    "networkPolicy",
    "metrics",
    "tls",
    "authentication",
    "extraEnv",
    "extraVolumes",
    "extraVolumeMounts"
  ],
  "properties": {
    "replicaCount": {
      "type": "integer",
      "const": 3
    },
    "image": {
      "type": "object",
      "required": ["repository", "tag", "digest", "pullPolicy", "pullSecrets"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "const": "3.9.5"},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]},
        "pullSecrets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "nameOverride": {"type": "string"},
    "fullnameOverride": {"type": "string"},
    "commonLabels": {
      "type": "object",
      "required": ["app", "contact", "env", "fismaid"],
      "properties": {
        "app": {"type": "string", "minLength": 1},
        "contact": {"type": "string", "minLength": 1},
        "env": {"type": "string", "minLength": 1},
        "fismaid": {"type": "string", "minLength": 1}
      },
      "additionalProperties": {"type": "string"}
    },
    "serviceAccount": {
      "type": "object",
      "required": ["create", "name", "annotations", "automountServiceAccountToken"],
      "properties": {
        "create": {"type": "boolean"},
        "name": {"type": "string"},
        "annotations": {"$ref": "#/definitions/stringMap"},
        "automountServiceAccountToken": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "podAnnotations": {"$ref": "#/definitions/stringMap"},
    "podLabels": {"$ref": "#/definitions/stringMap"},
    "service": {
      "type": "object",
      "required": ["client", "headless"],
      "properties": {
        "client": {
          "type": "object",
          "required": ["type", "port", "annotations"],
          "properties": {
            "type": {"type": "string", "enum": ["ClusterIP"]},
            "port": {"type": "integer", "minimum": 1, "maximum": 65535},
            "annotations": {"$ref": "#/definitions/stringMap"}
          },
          "additionalProperties": false
        },
        "headless": {
          "type": "object",
          "required": ["annotations"],
          "properties": {
            "annotations": {"$ref": "#/definitions/stringMap"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "configuration": {
      "type": "object",
      "required": [
        "tickTime",
        "initLimit",
        "syncLimit",
        "maxClientConnections",
        "fourLetterWordWhitelist",
        "autopurgeSnapRetainCount",
        "autopurgePurgeInterval",
        "adminServerEnabled",
        "preAllocSize",
        "snapCount",
        "minSessionTimeout",
        "maxSessionTimeout",
        "extra"
      ],
      "properties": {
        "tickTime": {"type": "integer", "minimum": 1},
        "initLimit": {"type": "integer", "minimum": 1},
        "syncLimit": {"type": "integer", "minimum": 1},
        "maxClientConnections": {"type": "integer", "minimum": 1},
        "fourLetterWordWhitelist": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_*.-]+(,[A-Za-z0-9_*.-]+)*$"
        },
        "autopurgeSnapRetainCount": {"type": "integer", "minimum": 3},
        "autopurgePurgeInterval": {"type": "integer", "minimum": 0},
        "adminServerEnabled": {"type": "boolean"},
        "preAllocSize": {"type": "integer", "minimum": 1},
        "snapCount": {"type": "integer", "minimum": 2},
        "minSessionTimeout": {"type": "integer", "minimum": 1},
        "maxSessionTimeout": {"type": "integer", "minimum": 1},
        "extra": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "number", "boolean"]
          }
        }
      },
      "additionalProperties": false
    },
    "jvm": {
      "type": "object",
      "required": ["heapOpts"],
      "properties": {
        "heapOpts": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "persistence": {
      "type": "object",
      "required": ["enabled", "storageClass", "accessModes", "size", "volumeMode", "annotations"],
      "properties": {
        "enabled": {"type": "boolean", "const": true},
        "storageClass": {"type": "string", "minLength": 1},
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {"type": "string", "const": "ReadWriteOnce"}
        },
        "size": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(Ei|Pi|Ti|Gi|Mi|Ki|E|P|T|G|M|K)$"
        },
        "volumeMode": {"type": "string", "const": "Filesystem"},
        "annotations": {"$ref": "#/definitions/stringMap"}
      },
      "additionalProperties": false
    },
    "resources": {
      "type": "object",
      "required": ["requests", "limits"],
      "properties": {
        "requests": {"$ref": "#/definitions/resourceMap"},
        "limits": {"$ref": "#/definitions/resourceMap"}
      },
      "additionalProperties": false
    },
    "probes": {
      "type": "object",
      "required": ["liveness", "readiness"],
      "properties": {
        "liveness": {"$ref": "#/definitions/probe"},
        "readiness": {"$ref": "#/definitions/probe"}
      },
      "additionalProperties": false
    },
    "terminationGracePeriodSeconds": {"type": "integer", "minimum": 1},
    "securityContext": {
      "type": "object",
      "required": ["pod", "container"],
      "properties": {
        "pod": {
          "type": "object",
          "required": [
            "runAsNonRoot",
            "runAsUser",
            "runAsGroup",
            "fsGroup",
            "fsGroupChangePolicy",
            "seccompProfile"
          ],
          "properties": {
            "runAsNonRoot": {"type": "boolean"},
            "runAsUser": {"type": "integer", "minimum": 1},
            "runAsGroup": {"type": "integer", "minimum": 1},
            "fsGroup": {"type": "integer", "minimum": 1},
            "fsGroupChangePolicy": {
              "type": "string",
              "enum": ["Always", "OnRootMismatch"]
            },
            "seccompProfile": {
              "type": "object",
              "required": ["type"],
              "properties": {
                "type": {"type": "string", "enum": ["RuntimeDefault", "Localhost"]},
                "localhostProfile": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "container": {
          "type": "object",
          "required": [
            "allowPrivilegeEscalation",
            "readOnlyRootFilesystem",
            "capabilities"
          ],
          "properties": {
            "allowPrivilegeEscalation": {"type": "boolean"},
            "readOnlyRootFilesystem": {"type": "boolean"},
            "capabilities": {
              "type": "object",
              "required": ["drop"],
              "properties": {
                "drop": {
                  "type": "array",
                  "minItems": 1,
                  "items": {"type": "string"}
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "topology": {
      "type": "object",
      "required": ["zoneKey", "hostKey", "maxSkew", "minDomains", "whenUnsatisfiable"],
      "properties": {
        "zoneKey": {"type": "string", "minLength": 1},
        "hostKey": {"type": "string", "minLength": 1},
        "maxSkew": {"type": "integer", "const": 1},
        "minDomains": {"type": "integer", "const": 3},
        "whenUnsatisfiable": {"type": "string", "const": "DoNotSchedule"}
      },
      "additionalProperties": false
    },
    "podDisruptionBudget": {
      "type": "object",
      "required": ["enabled", "maxUnavailable"],
      "properties": {
        "enabled": {"type": "boolean", "const": true},
        "maxUnavailable": {"type": "integer", "const": 1}
      },
      "additionalProperties": false
    },
    "networkPolicy": {
      "type": "object",
      "required": [
        "enabled",
        "brokerNamespaceSelector",
        "brokerPodSelector",
        "monitoringNamespaceSelector",
        "monitoringPodSelector"
      ],
      "properties": {
        "enabled": {"type": "boolean", "const": true},
        "brokerNamespaceSelector": {"$ref": "#/definitions/labelSelector"},
        "brokerPodSelector": {"$ref": "#/definitions/labelSelector"},
        "monitoringNamespaceSelector": {"$ref": "#/definitions/labelSelector"},
        "monitoringPodSelector": {"$ref": "#/definitions/labelSelector"}
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "required": ["enabled", "port", "serviceMonitor", "prometheusRule"],
      "properties": {
        "enabled": {"type": "boolean", "const": true},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "serviceMonitor": {
          "type": "object",
          "required": ["enabled", "labels", "interval", "scrapeTimeout", "honorLabels"],
          "properties": {
            "enabled": {"type": "boolean"},
            "labels": {"$ref": "#/definitions/stringMap"},
            "interval": {"$ref": "#/definitions/duration"},
            "scrapeTimeout": {"$ref": "#/definitions/duration"},
            "honorLabels": {"type": "boolean"}
          },
          "additionalProperties": false
        },
        "prometheusRule": {
          "type": "object",
          "required": ["enabled", "labels", "rules"],
          "properties": {
            "enabled": {"type": "boolean"},
            "labels": {"$ref": "#/definitions/stringMap"},
            "rules": {
              "type": "object",
              "required": ["quorumUnavailableFor"],
              "properties": {
                "quorumUnavailableFor": {"$ref": "#/definitions/duration"}
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "tls": {
      "type": "object",
      "required": ["client", "quorum"],
      "properties": {
        "client": {
          "type": "object",
          "required": [
            "enabled",
            "port",
            "secretName",
            "keyStoreFile",
            "trustStoreFile",
            "keyStorePasswordKey",
            "trustStorePasswordKey"
          ],
          "properties": {
            "enabled": {"type": "boolean"},
            "port": {"type": "integer", "minimum": 1, "maximum": 65535},
            "secretName": {"type": "string"},
            "keyStoreFile": {"type": "string", "minLength": 1},
            "trustStoreFile": {"type": "string", "minLength": 1},
            "keyStorePasswordKey": {"type": "string", "minLength": 1},
            "trustStorePasswordKey": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        "quorum": {
          "type": "object",
          "required": ["enabled"],
          "properties": {
            "enabled": {"type": "boolean"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "authentication": {
      "type": "object",
      "required": ["enabled", "jaasSecretName", "jaasFile"],
      "properties": {
        "enabled": {"type": "boolean"},
        "jaasSecretName": {"type": "string"},
        "jaasFile": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "extraEnv": {
      "type": "array",
      "items": {"type": "object"}
    },
    "extraVolumes": {
      "type": "array",
      "items": {"type": "object"}
    },
    "extraVolumeMounts": {
      "type": "array",
      "items": {"type": "object"}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "tls": {
            "properties": {
              "quorum": {
                "properties": {
                  "enabled": {"const": true}
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "tls": {
            "properties": {
              "client": {
                "properties": {
                  "enabled": {"const": true}
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tls": {
            "properties": {
              "client": {
                "properties": {
                  "enabled": {"const": true}
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "tls": {
            "properties": {
              "client": {
                "properties": {
                  "secretName": {"minLength": 1}
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "authentication": {
            "properties": {
              "enabled": {"const": true}
            }
          }
        }
      },
      "then": {
        "properties": {
          "authentication": {
            "properties": {
              "jaasSecretName": {"minLength": 1}
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false,
  "definitions": {
    "duration": {
      "type": "string",
      "pattern": "^[1-9][0-9]*(ms|s|m|h|d|w|y)$"
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "resourceMap": {
      "type": "object",
      "required": ["cpu", "memory"],
      "properties": {
        "cpu": {"type": ["string", "number"]},
        "memory": {"type": ["string", "number"]}
      },
      "additionalProperties": {
        "type": ["string", "number"]
      }
    },
    "probe": {
      "type": "object",
      "required": [
        "initialDelaySeconds",
        "periodSeconds",
        "timeoutSeconds",
        "failureThreshold"
      ],
      "properties": {
        "initialDelaySeconds": {"type": "integer", "minimum": 0},
        "periodSeconds": {"type": "integer", "minimum": 1},
        "timeoutSeconds": {"type": "integer", "minimum": 1},
        "failureThreshold": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "labelSelector": {
      "type": "object",
      "properties": {
        "matchLabels": {"$ref": "#/definitions/stringMap"},
        "matchExpressions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key", "operator"],
            "properties": {
              "key": {"type": "string", "minLength": 1},
              "operator": {
                "type": "string",
                "enum": ["In", "NotIn", "Exists", "DoesNotExist"]
              },
              "values": {
                "type": "array",
                "items": {"type": "string"}
              }
            },
            "additionalProperties": false
          }
        }
      },
      "minProperties": 1,
      "additionalProperties": false
    }
  }
}
