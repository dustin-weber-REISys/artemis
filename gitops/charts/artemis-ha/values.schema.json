{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["commonLabels", "ha", "zookeeper", "persistence", "broker", "security", "acceptors", "authentication", "destinations", "authorization", "console", "keycloak", "vault", "brokerProperties", "topology", "services", "networkPolicy", "monitoring"],
  "properties": {
    "nameOverride": {"type": "string", "maxLength": 63},
    "fullnameOverride": {"type": "string", "maxLength": 63},
    "commonLabels": {
      "type": "object",
      "required": ["app", "contact", "env", "fismaid"],
      "properties": {
        "app": {"$ref": "#/$defs/labelValue"},
        "contact": {"$ref": "#/$defs/labelValue"},
        "env": {"$ref": "#/$defs/labelValue"},
        "fismaid": {"$ref": "#/$defs/labelValue"}
      },
      "additionalProperties": {"$ref": "#/$defs/labelValue"}
    },
    "ha": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coordinationId", "groupName", "initialReplicationSyncTimeoutMs", "retryReplicationWaitMs", "zookeeperSessionTimeoutMs"],
      "properties": {
        "coordinationId": {"type": "string", "minLength": 8, "maxLength": 16, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{7,15}$"},
        "groupName": {"type": "string", "minLength": 1, "maxLength": 50},
        "initialReplicationSyncTimeoutMs": {"type": "integer", "minimum": 1000},
        "retryReplicationWaitMs": {"type": "integer", "minimum": 100},
        "zookeeperSessionTimeoutMs": {"type": "integer", "minimum": 3000}
      }
    },
    "zookeeper": {
      "type": "object",
      "additionalProperties": false,
      "required": ["connectString", "serviceNamespace", "curatorNamespace", "podSelector", "port"],
      "properties": {
        "connectString": {"type": "string", "minLength": 1},
        "serviceNamespace": {"type": "string", "minLength": 1},
        "curatorNamespace": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"},
        "podSelector": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535}
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size", "storageClassName", "journalType"],
      "properties": {
        "size": {"type": "string", "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$"},
        "storageClassName": {"type": "string", "minLength": 1},
        "journalType": {"enum": ["NIO", "ASYNCIO"]}
      }
    },
    "broker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "adminUser", "resources", "revisionHistoryLimit", "nodeSelector", "tolerations", "labels", "annotations"],
      "properties": {
        "version": {"enum": ["2.21.0", "2.22.0", "2.23.0", "2.25.0", "2.26.0", "2.27.0", "2.27.1", "2.28.0", "2.29.0", "2.30.0", "2.31.0", "2.31.2", "2.32.0", "2.33.0", "2.34.0", "2.35.0", "2.36.0", "2.37.0", "2.38.0", "2.39.0", "2.40.0", "2.41.0", "2.42.0", "2.43.0", "2.44.0", "2.50.0", "2.51.0", "2.52.0", "2.53.0"]},
        "adminUser": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "resources": {"type": "object", "required": ["requests", "limits"], "properties": {"requests": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}}, "limits": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}}}, "additionalProperties": false},
        "revisionHistoryLimit": {"type": "integer", "minimum": 0},
        "nodeSelector": {"type": "object", "additionalProperties": {"type": "string"}},
        "tolerations": {"type": "array", "items": {"type": "object"}},
        "labels": {"type": "object", "additionalProperties": {"type": "string"}},
        "annotations": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "security": {"$ref": "#/$defs/security"},
    "acceptors": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/acceptor"},
      "propertyNames": {"pattern": "^[a-z][a-z0-9-]{0,31}$"},
      "minProperties": 1
    },
    "authentication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jaasSecretName"],
      "properties": {
        "jaasSecretName": {
          "type": "string",
          "anyOf": [
            {"const": ""},
            {"pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?-jaas-config$", "maxLength": 253}
          ]
        }
      }
    },
    "destinations": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9-]{0,62}$"},
      "additionalProperties": {"$ref": "#/$defs/destination"}
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rules"],
      "properties": {
        "rules": {
          "type": "object",
          "propertyNames": {"pattern": "^[a-z][a-z0-9-]{0,62}$"},
          "additionalProperties": {"$ref": "#/$defs/authorizationRule"}
        }
      }
    },
    "console": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ingress"],
      "properties": {
        "ingress": {"$ref": "#/$defs/ingress"}
      }
    },
    "keycloak": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "displayName", "issuerUrl", "clientId", "scopes", "redirectUri", "rolesPath", "viewerRole", "administratorRole", "namespace", "podSelector", "port", "extraEnv"],
      "properties": {
        "enabled": {"type": "boolean"},
        "displayName": {"type": "string", "minLength": 1},
        "issuerUrl": {"type": "string", "format": "uri"},
        "clientId": {"type": "string", "minLength": 1},
        "scopes": {"type": "string", "minLength": 1},
        "redirectUri": {"type": "string", "format": "uri"},
        "rolesPath": {"type": "string", "minLength": 1},
        "viewerRole": {"type": "string", "minLength": 1},
        "administratorRole": {"type": "string", "minLength": 1},
        "namespace": {"type": "string", "minLength": 1},
        "podSelector": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "extraEnv": {"type": "array", "items": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}, "value": {"type": "string"}, "valueFrom": {"type": "object"}}, "additionalProperties": false}}
      }
    },
    "vault": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "role", "tlsSecretName", "caCertPath", "secretPath", "namespace", "podSelector", "port", "templates", "extraAnnotations"],
      "properties": {
        "enabled": {"type": "boolean"},
        "role": {"type": "string", "minLength": 1},
        "tlsSecretName": {"type": "string", "minLength": 1},
        "caCertPath": {"type": "string", "minLength": 1},
        "secretPath": {"type": "string", "minLength": 1},
        "namespace": {"type": "string", "minLength": 1},
        "podSelector": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "templates": {"type": "object", "required": ["brokerCredentials"], "properties": {"brokerCredentials": {"type": "string", "minLength": 1}}, "additionalProperties": false},
        "extraAnnotations": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "brokerProperties": {
      "type": "object",
      "additionalProperties": false,
      "required": ["durability", "globalMaxSize", "maxDiskUsage", "connectionTtlOverride", "duplicateDetectionIdCacheSize", "persistDuplicateDetectionIds", "addressSettings", "extra"],
      "properties": {
        "durability": {
          "type": "object",
          "additionalProperties": false,
          "required": ["journalSyncTransactional", "journalSyncNonTransactional", "journalDatasync", "largeMessageSync"],
          "properties": {
            "journalSyncTransactional": {"type": "boolean", "const": true},
            "journalSyncNonTransactional": {"type": "boolean", "const": true},
            "journalDatasync": {"type": "boolean", "const": true},
            "largeMessageSync": {"type": "boolean", "const": true}
          }
        },
        "globalMaxSize": {"type": "string", "minLength": 1},
        "maxDiskUsage": {"type": "integer", "minimum": 1, "maximum": 100},
        "connectionTtlOverride": {"type": "integer", "minimum": 0},
        "duplicateDetectionIdCacheSize": {"type": "integer", "minimum": 1},
        "persistDuplicateDetectionIds": {"type": "boolean"},
        "addressSettings": {"type": "object", "required": ["match", "maxSizeBytes", "pageSizeBytes", "addressFullPolicy", "maxDeliveryAttempts", "redeliveryDelay", "deadLetterAddress", "autoCreateDeadLetterResources", "deadLetterQueuePrefix", "deadLetterQueueSuffix", "autoDeleteQueues", "autoDeleteAddresses", "expiry", "autoCreateQueues", "autoCreateAddresses", "defaultAddressRoutingType", "defaultQueueRoutingType"], "properties": {"match": {"type": "string", "minLength": 1}, "maxSizeBytes": {"type": "integer", "minimum": 1}, "pageSizeBytes": {"type": "integer", "minimum": 1}, "addressFullPolicy": {"enum": ["PAGE", "BLOCK", "DROP", "FAIL" ]}, "maxDeliveryAttempts": {"type": "integer", "minimum": -1}, "redeliveryDelay": {"type": "integer", "minimum": 0}, "deadLetterAddress": {"type": "string", "minLength": 1}, "autoCreateDeadLetterResources": {"type": "boolean"}, "deadLetterQueuePrefix": {"type": "string", "minLength": 1}, "deadLetterQueueSuffix": {"type": "string"}, "autoDeleteQueues": {"type": "boolean"}, "autoDeleteAddresses": {"type": "boolean"}, "expiry": {"type": "object", "required": ["enabled", "address", "autoCreateResources", "queuePrefix", "queueSuffix"], "properties": {"enabled": {"type": "boolean"}, "address": {"type": "string", "minLength": 1}, "autoCreateResources": {"type": "boolean"}, "queuePrefix": {"type": "string", "minLength": 1}, "queueSuffix": {"type": "string"}}, "additionalProperties": false}, "autoCreateQueues": {"type": "boolean"}, "autoCreateAddresses": {"type": "boolean"}, "defaultAddressRoutingType": {"enum": ["ANYCAST", "MULTICAST"]}, "defaultQueueRoutingType": {"enum": ["ANYCAST", "MULTICAST"]}}, "additionalProperties": false},
        "extra": {"type": "array", "items": {"type": "string", "pattern": "^[^=]+=.*$"}}
      }
    },
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topologySpreadConstraints", "podAntiAffinity", "pdb"],
      "properties": {
        "topologySpreadConstraints": {"type": "array", "minItems": 2, "items": {"type": "object", "required": ["maxSkew", "minDomains", "topologyKey", "whenUnsatisfiable"], "properties": {"maxSkew": {"type": "integer", "minimum": 1}, "minDomains": {"type": "integer", "minimum": 2}, "topologyKey": {"type": "string", "minLength": 1}, "whenUnsatisfiable": {"enum": ["DoNotSchedule", "ScheduleAnyway"]}}, "additionalProperties": false}},
        "podAntiAffinity": {"type": "object", "additionalProperties": false, "required": ["requiredDuringSchedulingIgnoredDuringExecution"], "properties": {"requiredDuringSchedulingIgnoredDuringExecution": {"type": "array", "minItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["topologyKey"], "properties": {"topologyKey": {"type": "string", "minLength": 1}}}}}},
        "pdb": {"type": "object", "required": ["maxUnavailable"], "properties": {"maxUnavailable": {"type": ["integer", "string"], "minimum": 0}}, "additionalProperties": false}
      }
    },
    "services": {
      "type": "object",
      "additionalProperties": false,
      "required": ["internalTrafficPolicy"],
      "properties": {
        "internalTrafficPolicy": {"enum": ["Cluster", "Local"]}
      }
    },
    "networkPolicy": {"$ref": "#/$defs/networkPolicy"},
    "monitoring": {"$ref": "#/$defs/monitoring"}
  },
  "$defs": {
    "labelValue": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^(([A-Za-z0-9][-A-Za-z0-9_.]*)?[A-Za-z0-9])$"
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["serviceAccount", "podSecurityContext", "containerSecurityContext", "writableVolumes"],
      "properties": {
        "serviceAccount": {"type": "object", "required": ["create", "name", "automountServiceAccountToken"], "properties": {"create": {"type": "boolean"}, "name": {"type": "string"}, "automountServiceAccountToken": {"type": "boolean"}}, "additionalProperties": false},
        "podSecurityContext": {"type": "object"},
        "containerSecurityContext": {"type": "object"},
        "writableVolumes": {"type": "array", "items": {"type": "object", "required": ["name", "mountPath"], "properties": {"name": {"type": "string", "minLength": 1}, "mountPath": {"type": "string", "minLength": 1}}, "additionalProperties": false}}
      }
    },
    "acceptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "port", "protocols", "connectionsAllowed", "bindToAllInterfaces", "supportAdvisory", "suppressInternalManagementObjects", "sslEnabled", "needClientAuth", "sslSecret", "trustSecret", "extraParams"],
      "properties": {
        "enabled": {"type": "boolean"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "protocols": {"type": "string", "pattern": "^(CORE|OPENWIRE|AMQP|STOMP|MQTT)(,(CORE|OPENWIRE|AMQP|STOMP|MQTT))*$"},
        "connectionsAllowed": {"type": "integer", "minimum": 1},
        "bindToAllInterfaces": {"type": "boolean", "const": true},
        "supportAdvisory": {"type": "boolean"},
        "suppressInternalManagementObjects": {"type": "boolean"},
        "sslEnabled": {"type": "boolean"},
        "needClientAuth": {"type": "boolean"},
        "sslSecret": {
          "type": "string",
          "anyOf": [
            {"const": ""},
            {"pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$", "maxLength": 253}
          ]
        },
        "trustSecret": {
          "type": "string",
          "anyOf": [
            {"const": ""},
            {"pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$", "maxLength": 253}
          ]
        },
        "extraParams": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "destinationName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
    },
    "roleName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "roleList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/roleName"}
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address", "routingTypes", "queues"],
      "properties": {
        "address": {"$ref": "#/$defs/destinationName"},
        "routingTypes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["ANYCAST", "MULTICAST"]}
        },
        "queues": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "routingType", "durable", "maxConsumers", "purgeOnNoConsumers"],
            "properties": {
              "name": {"$ref": "#/$defs/destinationName"},
              "routingType": {"enum": ["ANYCAST", "MULTICAST"]},
              "durable": {"type": "boolean"},
              "maxConsumers": {"type": "integer", "minimum": -1},
              "purgeOnNoConsumers": {"type": "boolean"}
            }
          }
        }
      }
    },
    "authorizationRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["match", "permissions"],
      "properties": {
        "match": {"type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[A-Za-z0-9#*][A-Za-z0-9#*._:/-]*$"},
        "permissions": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "send": {"$ref": "#/$defs/roleList"},
            "consume": {"$ref": "#/$defs/roleList"},
            "browse": {"$ref": "#/$defs/roleList"},
            "manage": {"$ref": "#/$defs/roleList"},
            "view": {"$ref": "#/$defs/roleList"},
            "edit": {"$ref": "#/$defs/roleList"},
            "createAddress": {"$ref": "#/$defs/roleList"},
            "deleteAddress": {"$ref": "#/$defs/roleList"},
            "createDurableQueue": {"$ref": "#/$defs/roleList"},
            "deleteDurableQueue": {"$ref": "#/$defs/roleList"},
            "createNonDurableQueue": {"$ref": "#/$defs/roleList"},
            "deleteNonDurableQueue": {"$ref": "#/$defs/roleList"}
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "className", "host", "annotations"],
      "properties": {
        "enabled": {"type": "boolean"},
        "className": {"type": "string", "minLength": 1},
        "host": {"type": "string", "minLength": 1},
        "annotations": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "clientSources", "managementSources", "monitoringSources", "extraIngress", "extraEgress"],
      "properties": {
        "enabled": {"type": "boolean"},
        "clientSources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
        "managementSources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
        "monitoringSources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
        "extraIngress": {"type": "array", "items": {"type": "object"}},
        "extraEgress": {"type": "array", "items": {"type": "object"}}
      }
    },
    "source": {
      "type": "object",
      "required": ["namespaceSelector", "podSelector"],
      "properties": {"namespaceSelector": {"type": "object"}, "podSelector": {"type": "object"}},
      "additionalProperties": false
    },
    "monitoring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "serviceMonitor", "prometheusRule"],
      "properties": {
        "enabled": {"type": "boolean"},
        "pendingMessagesWarningThreshold": {"type": "integer", "minimum": 1},
        "activeMetricName": {"type": "string", "anyOf": [{"const": ""}, {"pattern": "^[a-zA-Z_:][a-zA-Z0-9_:]*$"}]},
        "replicationSynchronizedMetricName": {"type": "string", "anyOf": [{"const": ""}, {"pattern": "^[a-zA-Z_:][a-zA-Z0-9_:]*$"}]},
        "extraRules": {"type": "array", "items": {"type": "object"}},
        "serviceMonitor": {"type": "object", "required": ["enabled", "namespace", "labels", "interval", "scrapeTimeout", "path", "port"], "properties": {"enabled": {"type": "boolean"}, "namespace": {"type": "string"}, "labels": {"type": "object", "additionalProperties": {"type": "string"}}, "interval": {"type": "string", "minLength": 1}, "scrapeTimeout": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}, "port": {"type": "string", "minLength": 1}}, "additionalProperties": false},
        "prometheusRule": {"type": "object", "required": ["enabled", "namespace", "labels", "severity"], "properties": {"enabled": {"type": "boolean"}, "namespace": {"type": "string"}, "labels": {"type": "object", "additionalProperties": {"type": "string"}}, "severity": {"type": "string", "minLength": 1}}, "additionalProperties": false}
      }
    }
  }
}
