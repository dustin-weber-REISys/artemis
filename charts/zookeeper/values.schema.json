{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["enabled", "haMode", "replicaCount", "image", "persistence", "resources"],
  "properties": {
    "enabled": {"type": "boolean"},
    "haMode": {"type": "string", "enum": ["quorum", "none"]},
    "replicaCount": {"type": "integer", "minimum": 1},
    "image": {
      "type": "object",
      "required": ["registry", "repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "registry": {"type": "string", "minLength": 1},
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "const": "3.9.5"},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]},
        "pullSecrets": {"type": "array", "items": {"type": "object"}}
      },
      "additionalProperties": true
    },
    "persistence": {
      "type": "object",
      "required": ["enabled", "storageClass", "accessModes", "size", "volumeMode"],
      "properties": {
        "enabled": {"type": "boolean"},
        "storageClass": {"type": "string", "minLength": 1},
        "accessModes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "size": {"type": "string", "minLength": 1},
        "volumeMode": {"type": "string", "enum": ["Filesystem", "Block"]},
        "annotations": {"type": "object"}
      },
      "additionalProperties": true
    },
    "resources": {"type": "object"},
    "configuration": {"type": "object"},
    "jvm": {"type": "object"},
    "service": {"type": "object"},
    "serviceAccount": {"type": "object"},
    "securityContext": {"type": "object"},
    "topology": {"type": "object"},
    "podDisruptionBudget": {"type": "object"},
    "networkPolicy": {"type": "object"},
    "metrics": {"type": "object"},
    "tls": {"type": "object"},
    "authentication": {"type": "object"},
    "extraEnv": {"type": "array"},
    "extraVolumes": {"type": "array"},
    "extraVolumeMounts": {"type": "array"}
  },
  "additionalProperties": true
}
